{
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "launcher.html", "use": "@vercel/static" },
    { "src": "sw.js", "use": "@vercel/static" },
    { "src": "data/*.json", "use": "@vercel/static" },
    { "src": "data/team-news/*.json", "use": "@vercel/static" },
    { "src": "games/**/*.html", "use": "@vercel/static" },
    { "src": "games/wheelie-fun-turbo/manifest.webmanifest", "use": "@vercel/static" },
    { "src": "games/wheelie-fun-turbo/icons/*.png", "use": "@vercel/static" },
    { "src": ".well-known/assetlinks.json", "use": "@vercel/static" },
    { "src": "api/scoreboard.js", "use": "@vercel/node" },
    { "src": "api/standings.js", "use": "@vercel/node" },
    { "src": "api/summary.js", "use": "@vercel/node" },
    { "src": "api/highlights.js", "use": "@vercel/node" },
    { "src": "api/team-news.js", "use": "@vercel/node" },
    { "src": "api/roster.js", "use": "@vercel/node" },
    { "src": "api/player.js", "use": "@vercel/node" },
    { "src": "api/fpl.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/fpl-(.*)", "dest": "/api/fpl.js" },
    { "src": "/api/(.*)", "dest": "/api/$1.js" },
    {
      "src": "/games/wheelie-fun-turbo/pad.html",
      "headers": { "Cache-Control": "no-cache, must-revalidate" },
      "continue": true
    },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
